
name: NOVA Validate and Build

on:
  workflow_dispatch:
    inputs:
      project_zip:
        description: "Exact NOVA project ZIP in repository root"
        required: false
        default: "NOVA_v2_1_Combined_Android_Windows.zip"
        type: string
  pull_request:
    branches: [main]
    types: [opened, synchronize, reopened, ready_for_review]

concurrency:
  group: nova-validate-build-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

env:
  SRC_DIR: _nova_src

jobs:
  validate:
    name: Validate NOVA
    runs-on: ubuntu-latest
    timeout-minutes: 30
    outputs:
      source_mode: ${{ steps.locate.outputs.source_mode }}
      zip_path: ${{ steps.locate.outputs.zip_path }}
      pubspec_in_zip: ${{ steps.locate.outputs.pubspec_in_zip }}
      project_version: ${{ steps.locate.outputs.project_version }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Locate NOVA project
        id: locate
        env:
          INPUT_ZIP: ${{ github.event.inputs.project_zip }}
        run: |
          set -euo pipefail

          if [ -z "${INPUT_ZIP:-}" ] && [ -f pubspec.yaml ] && grep -q 'sdk: flutter' pubspec.yaml; then
            echo "source_mode=root" >> "$GITHUB_OUTPUT"
            echo "zip_path=" >> "$GITHUB_OUTPUT"
            echo "pubspec_in_zip=" >> "$GITHUB_OUTPUT"
            echo "project_version=$(grep -m1 '^version:' pubspec.yaml | awk '{print $2}' || true)" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          ZIP_TO_USE="${INPUT_ZIP:-NOVA_v2_1_Combined_Android_Windows.zip}"

          if [ ! -f "$ZIP_TO_USE" ]; then
            echo "::error::Project ZIP not found: $ZIP_TO_USE"
            exit 1
          fi

          case "$ZIP_TO_USE" in
            *.zip) ;;
            *) echo "::error::The project file must be a ZIP."; exit 1 ;;
          esac

          mapfile -t matches < <(unzip -Z1 "$ZIP_TO_USE" | grep -E '(^|/)pubspec\.yaml$' || true)

          if [ "${#matches[@]}" -eq 0 ]; then
            echo "::error::No pubspec.yaml found in ZIP."
            exit 1
          fi

          pub="$(printf '%s\n' "${matches[@]}" | awk '{ n=gsub(/\//,"/"); print n, $0 }' | sort -n | head -1 | cut -d' ' -f2-)"
          content="$(unzip -p "$ZIP_TO_USE" "$pub")"

          if ! grep -q 'sdk: flutter' <<< "$content"; then
            echo "::error::The selected ZIP is not a Flutter project."
            exit 1
          fi

          ver="$(grep -m1 '^version:' <<< "$content" | awk '{print $2}' | cut -d+ -f1 || true)"

          echo "source_mode=zip" >> "$GITHUB_OUTPUT"
          echo "zip_path=$ZIP_TO_USE" >> "$GITHUB_OUTPUT"
          echo "pubspec_in_zip=$pub" >> "$GITHUB_OUTPUT"
          echo "project_version=${ver:-unknown}" >> "$GITHUB_OUTPUT"

      - name: Extract project
        if: steps.locate.outputs.source_mode == 'zip'
        env:
          ZIP_PATH: ${{ steps.locate.outputs.zip_path }}
          PUBSPEC_PATH: ${{ steps.locate.outputs.pubspec_in_zip }}
        run: |
          set -euo pipefail
          mkdir -p "$SRC_DIR"
          unzip -q "$ZIP_PATH" -d "$SRC_DIR"
          test -f "$SRC_DIR/$PUBSPEC_PATH"

      - name: Resolve project directory
        id: proj
        run: |
          set -euo pipefail
          if [ "${{ steps.locate.outputs.source_mode }}" = "root" ]; then
            dir="."
          else
            dir="$(dirname "$SRC_DIR/${{ steps.locate.outputs.pubspec_in_zip }}")"
          fi
          echo "dir=$dir" >> "$GITHUB_OUTPUT"

      - name: Get dependencies
        working-directory: ${{ steps.proj.outputs.dir }}
        run: flutter pub get

      - name: Analyze Flutter project
        working-directory: ${{ steps.proj.outputs.dir }}
        run: flutter analyze --no-fatal-infos --no-fatal-warnings

      - name: Run tests if available
        working-directory: ${{ steps.proj.outputs.dir }}
        run: |
          set -euo pipefail
          if find test -name '*_test.dart' 2>/dev/null | grep -q .; then
            flutter test
          else
            echo "No Flutter tests found. Skipping."
          fi

  build-android:
    name: Build Android APK
    needs: validate
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Extract project
        if: needs.validate.outputs.source_mode == 'zip'
        env:
          ZIP_PATH: ${{ needs.validate.outputs.zip_path }}
          PUBSPEC_PATH: ${{ needs.validate.outputs.pubspec_in_zip }}
        run: |
          set -euo pipefail
          mkdir -p "$SRC_DIR"
          unzip -q "$ZIP_PATH" -d "$SRC_DIR"
          test -f "$SRC_DIR/$PUBSPEC_PATH"

      - name: Resolve project directory
        id: proj
        run: |
          set -euo pipefail
          if [ "${{ needs.validate.outputs.source_mode }}" = "root" ]; then
            dir="."
          else
            dir="$(dirname "$SRC_DIR/${{ needs.validate.outputs.pubspec_in_zip }}")"
          fi
          echo "dir=$dir" >> "$GITHUB_OUTPUT"

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: gradle-${{ runner.os }}-${{ hashFiles('_nova_src/**/pubspec.yaml', 'pubspec.yaml') }}
          restore-keys: |
            gradle-${{ runner.os }}-

      - name: Generate Android project
        working-directory: ${{ steps.proj.outputs.dir }}
        run: flutter create --platforms=android --project-name nova .

      - name: Apply Android SDK and permissions configuration
        working-directory: ${{ steps.proj.outputs.dir }}
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          import re
          import subprocess
          import sys

          candidates = [
              Path("android/app/build.gradle"),
              Path("android/app/build.gradle.kts")
          ]

          gradle = next((p for p in candidates if p.is_file()), None)

          if gradle is None:
              raise SystemExit("Android app Gradle file not found.")

          original = gradle.read_text()

          patterns = [
              r"(?m)^(\s*compileSdkVersion\s+)([^\s;]+)",
              r"(?m)^(\s*compileSdk\s*=\s*)([^\s;]+)",
              r"(?m)^(\s*compileSdk\s+)([^\s;]+)"
          ]

          updated = original

          for pattern in patterns:
              updated, count = re.subn(pattern, r"\g<1>36", updated, count=1)
              if count:
                  break

          if updated == original:
              raise SystemExit("Could not safely find compileSdk declaration.")

          gradle.write_text(updated)
          print(f"Set compileSdk 36 in {gradle}")

          permissions = Path("scripts/ensure_android_permissions.py")

          if permissions.is_file():
              subprocess.run([sys.executable, str(permissions)], check=True)
          else:
              print("Permissions script not found; skipped.")

          for name in [
              "configure_android_overlay.py",
              "configure_android_reminders.py"
          ]:
              path = Path("scripts") / name
              if path.is_file():
                  subprocess.run([sys.executable, str(path)], check=True)
              else:
                  print(f"{name} not found; skipped.")
          PY

      - name: Verify Android configuration
        working-directory: ${{ steps.proj.outputs.dir }}
        run: |
          set -euo pipefail

          gradle=""
          for f in android/app/build.gradle android/app/build.gradle.kts; do
            if [ -f "$f" ]; then
              gradle="$f"
              break
            fi
          done

          [ -n "$gradle" ] || {
            echo "::error::Android Gradle file missing."
            exit 1
          }

          grep -Eq 'compileSdk(Version)?[[:space:]]*(=[[:space:]]*|[[:space:]]+)36([[:space:];]|$)' "$gradle" || {
            echo "::error::compileSdk 36 verification failed."
            exit 1
          }

          test -f android/app/src/main/AndroidManifest.xml

      - name: Get dependencies
        working-directory: ${{ steps.proj.outputs.dir }}
        run: flutter pub get

      - name: Build release APK
        working-directory: ${{ steps.proj.outputs.dir }}
        run: flutter build apk --release

      - name: Confirm APK exists
        working-directory: ${{ steps.proj.outputs.dir }}
        run: |
          set -euo pipefail
          apk="build/app/outputs/flutter-apk/app-release.apk"
          test -f "$apk"
          ls -lh "$apk"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: NOVA-Android-APK-validated
          path: ${{ steps.proj.outputs.dir }}/build/app/outputs/flutter-apk/app-release.apk
          retention-days: 30
          if-no-files-found: error
